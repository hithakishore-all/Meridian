# Copy this file to .env (cp .env.example .env) and fill in what you use.
# Offline mode needs none of this: run `npm run offline`.

# ---------- Server
# MERIDIAN_MODE=offline        # or pass --offline
# MERIDIAN_PORT=3000
# MERIDIAN_HOST=127.0.0.1      # 0.0.0.0 opens it to your network; only do that on a trusted network

# ---------- Snowflake (live mode). See docs/SETUP_SNOWFLAKE.md
SNOWFLAKE_ACCOUNT=             # e.g. myorg-myaccount
SNOWFLAKE_USER=MERIDIAN_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=.keys/meridian_svc.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=   # only if you encrypted the key
SNOWFLAKE_ROLE=MERIDIAN_APP
SNOWFLAKE_WAREHOUSE=MERIDIAN_WH
SNOWFLAKE_DATABASE=MERIDIAN

# ---------- Slack (optional). See docs/SETUP_SLACK.md
SLACK_BOT_TOKEN=               # starts with xoxb-
SLACK_APP_TOKEN=               # starts with xapp-
